{
  "name": "e-mine",
  "private": true,
  "description": "e-mine — MINE-GUINÉE 360° : site public, application de gestion et API",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose stop",
    "infra:ps": "docker compose ps",
    "infra:logs": "docker compose logs -f --tail=100",
    "api:dev": "node scripts/mvnw.mjs -pl api spring-boot:run -Djooq.codegen.skip=true",
    "api:verify": "node scripts/mvnw.mjs -B -pl api verify",
    "api:format": "node scripts/mvnw.mjs -q -pl api spotless:apply",
    "db:codegen": "node scripts/mvnw.mjs -q -pl api generate-sources -Djooq.codegen.args=--force",
    "infra:keycloak:reset": "docker compose up -d --wait --force-recreate keycloak",
    "db:seed": "node scripts/db-seed.mjs"
  }
}
