# e-mine — variables d'environnement (exemple)
# Copier ce fichier en .env et adapter les valeurs. Le fichier .env n'est jamais versionné.
# TOUTES LES VALEURS CI-DESSOUS SONT FICTIVES : aucune ne doit servir hors d'un poste de développement.

# --- Base de données (PostgreSQL 16, port 5432) ---
POSTGRES_PASSWORD=changeme-postgres
EMINE_OWNER_PASSWORD=changeme-owner
EMINE_APP_PASSWORD=changeme-app
DB_URL=jdbc:postgresql://localhost:5432/emine

# --- Keycloak (port 8081) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-keycloak
OIDC_ISSUER=http://localhost:8081/realms/emine
OIDC_CLIENT_ID_APP=emine-app
OIDC_CLIENT_SECRET_APP=changeme-client-secret
OIDC_CLIENT_ID_WEB=emine-web
# Mot de passe commun des personas de démo (realm infra/keycloak) : 12 caractères min., majuscule, chiffre, symbole
DEMO_PASSWORD=Demo-Emine-2026!

# --- BFF Next.js ---
SESSION_SECRET=changeme-session-secret-32-caracteres-min
API_BASE_URL=http://localhost:8080

# --- MinIO (API 9000, console 9001) ---
MINIO_ROOT_USER=emine-minio
MINIO_ROOT_PASSWORD=changeme-minio
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_PIECES=emine-pieces
S3_BUCKET_DOCUMENTS=emine-documents

# --- TrésorPay (simulateur, port 8090) ---
TRESORPAY_BASE_URL=http://localhost:8090
TRESORPAY_HMAC_SECRET=changeme-hmac-secret
TRESORPAY_MERCHANT_ID=MARCHAND-TEST-0001

# --- Signature (pkcs12 sur l'hôte, pkcs11 avec SoftHSM2 dans Docker) ---
SIGNATURE_MODE=pkcs12
SIGNATURE_PKCS11_LIB=/usr/lib/softhsm/libsofthsm2.so
SIGNATURE_PKCS11_PIN=changeme-pin
SIGNATURE_PKCS12_PATH=./infra/signature/certificat-test.p12
SIGNATURE_PKCS12_PASSWORD=changeme-p12
TSA_URL=

# --- Cadastre (simulateur, port 8091) ---
CADASTRE_MODE=simulateur
CADASTRE_BASE_URL=http://localhost:8091

# --- SMS / e-mail (Mailpit SMTP 1025) ---
SMS_MODE=simulateur
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Virement (coordonnées fictives) ---
VIREMENT_BENEFICIAIRE=Beneficiaire Fictif
VIREMENT_BANQUE=Banque Fictive
VIREMENT_IBAN=GN00 0000 0000 0000 0000 0000 000
