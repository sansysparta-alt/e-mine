      "Bash(docker system prune *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(gh issue create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(docker compose down *)"
    ],
