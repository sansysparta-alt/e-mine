      "PowerShell(git push * --force*)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git commit --amend*)",
      "Edit(_client/**)",
      "Read(.env)",
      "Read(**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); case \"$input\" in *'git push'*) b=$(git branch --show-current 2>/dev/null); if [ \"$b\" = \"main\" ] || [ \"$b\" = \"master\" ]; then echo \"Push refusé : la branche courante est $b. Travaille sur une branche de story (us-xx.y-...).\" >&2; exit 2; fi;; esac; exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/format-lint.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
