#!/bin/sh
# e-mine — hook de pré-commit (docs/05 §9.4)
# Activation (une fois par poste) : git config core.hooksPath .githooks
# 1. Gitleaks bloque tout secret indexé avant qu'il parte.
# 2. Formatage des fichiers indexés (ajouté avec le monorepo front, US-00.5).

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit : gitleaks est introuvable. Installer : winget install Gitleaks.Gitleaks" >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner || {
  echo "pre-commit : secret potentiel détecté, commit bloqué. Retirer la valeur et la placer dans .env." >&2
  exit 1
}

if [ -f "scripts/hooks/pre-commit-format.mjs" ] && [ -d "node_modules" ]; then
  node scripts/hooks/pre-commit-format.mjs || exit 1
fi

exit 0
