            }
          }
        }
      }
    },
    "/api/v1/demandes" : {
      "get" : {
        "tags" : [ "Demandes" ],
        "summary" : "Mes demandes (toutes pour un agent), paginées, filtrables par statut, document et recherche, triables",
        "operationId" : "listerDemandes",
        "parameters" : [ {
          "name" : "statut",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "pattern" : "^[a-z_]+$"
            }
          }
        }, {
          "name" : "typeDocumentCode",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "pattern" : "^[A-Z]{3}$"
          }
        }, {
          "name" : "q",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          }
        }, {
          "name" : "tri",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "pattern" : "^(numero|date|statut)$"
          }
        }, {
          "name" : "sens",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "pattern" : "^(asc|desc)$"
          }
        }, {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "name" : "taille",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageDemandesDto"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "Demandes" ],
        "summary" : "Créer une demande au statut brouillon",
        "operationId" : "creerBrouillon",
