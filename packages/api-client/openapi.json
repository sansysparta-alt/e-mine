                "$ref" : "#/components/schemas/BrouillonDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DemandeDto"
                }
              }
            }
          }
        }
      }
    },
